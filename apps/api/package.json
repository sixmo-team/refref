{
  "name": "@refref/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "openapi.yaml"],
  "scripts": {
    "dev": "portless refref-api -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest --maxWorkers=1",
    "test:ui": "vitest --ui --maxWorkers=1",
    "test:run": "vitest run --maxWorkers=1",
    "type:check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "@fastify/cors": "^10.1.0",
    "@paralleldrive/cuid2": "^2.3.1",
    "@refref/auth": "workspace:*",
    "@refref/coredb": "workspace:*",
    "@refref/id": "workspace:*",
    "@refref/types": "workspace:*",
    "@refref/utils": "workspace:*",
    "@tsndr/cloudflare-worker-jwt": "^3.2.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/ui": "^4.1.12",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
