# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/refref"

# Referral Configuration
# With portless: http://refref-refer.localhost:1355 | Without: http://localhost:3002
REFERRAL_HOST_URL="http://refref-refer.localhost:1355"

# Optional independent RefRef Postbox configuration; no live mail is enabled here.
# Supply RefRef's own verified From, never another application's sender or secrets.
REFREF_POSTBOX_FROM=""
# Supply BOTH keys, or omit them for the official Node credential chain.
REFREF_POSTBOX_ACCESS_KEY_ID=""
REFREF_POSTBOX_SECRET_ACCESS_KEY=""
REFREF_POSTBOX_SESSION_TOKEN=""
