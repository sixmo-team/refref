{
  "name": "@refref/webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "pnpm -F @refref/coredb db:generate",
    "db:migrate": "pnpm -F @refref/coredb db:migrate",
    "db:push": "pnpm -F @refref/coredb db:push",
    "db:studio": "pnpm -F @refref/coredb db:studio",
    "db:seed": "pnpm -F @refref/coredb db:seed",
    "dev": "portless refref-webapp -- next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest --maxWorkers=1",
    "test:ui": "vitest --ui --maxWorkers=1",
    "test:run": "vitest run --maxWorkers=1",
    "type:check": "tsc --noEmit"
