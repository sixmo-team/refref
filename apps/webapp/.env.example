# RefRef Webapp Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Database Configuration (REQUIRED)
# PostgreSQL connection string
# For Docker: use the default below
# For local: update with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/refref"

# Authentication (REQUIRED)
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here-change-in-production"

# Disable public signup in isolated deployments; use the operator bootstrap instead.
DISABLE_SIGN_UP="false"

# Authentication URL (OPTIONAL)
# The URL where Better Auth is hosted
# With portless: http://refref-webapp.localhost:1355 | Without: http://localhost:3000
BETTER_AUTH_URL="http://refref-webapp.localhost:1355"

# Application URL (OPTIONAL)
# The public URL of your application
# With portless: http://refref-webapp.localhost:1355 | Without: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://refref-webapp.localhost:1355"

# Google OAuth (OPTIONAL)
# Required only if you want to enable Google sign-in
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Independent RefRef email - Yandex Cloud Postbox (OPTIONAL, not activated here)
# RefRef needs its own approved/verified sender and send-authorized service account.
# Leave blank to keep delivery unconfigured. Never copy another service's credentials.
REFREF_POSTBOX_FROM=""
# Supply BOTH keys, or omit them to use the official Node credential chain.
REFREF_POSTBOX_ACCESS_KEY_ID=""
REFREF_POSTBOX_SECRET_ACCESS_KEY=""
REFREF_POSTBOX_SESSION_TOKEN=""
# Direct endpoint: https://postbox.cloud.yandex.net ; region: ru-central1

# Referral Program Configuration (OPTIONAL)
# These are used if you want to dogfood RefRef for your own referral program
# Leave these empty to run without the referral widget
# REFERRAL_PROGRAM_CLIENT_ID=""
# REFERRAL_PROGRAM_CLIENT_SECRET=""
# NEXT_PUBLIC_REFREF_PRODUCT_ID=""
# NEXT_PUBLIC_REFREF_PROGRAM_ID=""

# Widget and attribution scripts always load from the application's own /assets path.
# Serve the locally built bundles there through the application's gateway.
