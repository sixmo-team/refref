{
  "name": "@refref/refer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "portless refref-refer -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest --maxWorkers=1",
    "test:ui": "vitest --ui --maxWorkers=1",
    "test:run": "vitest run --maxWorkers=1",
    "type:check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@refref/coredb": "workspace:*",
    "@refref/types": "workspace:*",
    "@refref/utils": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/ui": "^4.1.12",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
