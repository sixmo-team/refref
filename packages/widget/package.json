{
  "name": "@refref/widget",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/widget.umd.js",
  "module": "./dist/widget.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/widget.es.js",
      "require": "./dist/widget.umd.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:prod": "vite build --mode production",
    "build:widget": "vite build --out-dir dist/widget --mode development",
    "build:widget:production": "vite build --out-dir dist/widget --mode production",
    "lint": "eslint . --report-unused-disable-directives",
    "test": "vitest run --maxWorkers=1",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@refref/types": "workspace:*",
    "@refref/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^0.483.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@refref/eslint-config": "workspace:*",
    "@refref/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^4.1.12",
    "vite-plugin-dts": "^5.1.2"
  }
}
