    "test:watch": "vitest --maxWorkers=1"
  },
  "dependencies": {
    "@refref/coredb": "workspace:*",
    "@refref/types": "workspace:*",
    "bad-words": "^4.1.5",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@refref/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
