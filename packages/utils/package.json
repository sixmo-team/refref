{
  "name": "@refref/utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/coredb": {
      "types": "./dist/plugins/coredb.d.ts",
      "import": "./dist/plugins/coredb.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
