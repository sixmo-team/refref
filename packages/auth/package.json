{
  "name": "@refref/auth",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./return": {
      "import": {
        "types": "./dist/es/return.d.ts",
        "default": "./dist/es/return.js"
      },
      "require": {
        "types": "./dist/cjs/return.d.cts",
        "default": "./dist/cjs/return.cjs"
      }
    }
  },
  "scripts": {
    "build": "bunchee",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "type:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@refref/eslint-config": "workspace:*",
    "@refref/typescript-config": "workspace:*",
    "@types/node": "^22.20.5",
    "bunchee": "^7.0.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1109.0",
    "@better-auth/api-key": "1.7.11",
    "@refref/coredb": "workspace:*",
    "@refref/email-templates": "workspace:*",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4"
  }
}
