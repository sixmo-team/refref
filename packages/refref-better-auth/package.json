{
  "name": "@refref/better-auth",
  "version": "0.1.0",
  "description": "Better Auth integration package for RefRef referral tracking",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --watch",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest --maxWorkers=1",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "better-call": "1.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@refref/types": "workspace:*",
    "@refref/typescript-config": "workspace:*",
    "bun-types": "1.3.14",
    "@types/node": "24.19.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "bun-types": "^1.3.14",
    "@types/node": "^22.20.5 || ^24.19.2",
    "better-auth": ">=1.7.11"
  },
  "peerDependenciesMeta": {
    "bun-types": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "better-auth",
    "refref",
    "referral",
    "tracking",
    "analytics",
    "authentication"
  ],
  "license": "MIT",
  "author": "RefRef",
  "repository": {
    "type": "git",
    "url": "https://github.com/refref/refref.git",
    "directory": "packages/refref-better-auth"
  }
}
