{
  "name": "refref",
  "private": true,
  "scripts": {
    "build": "turbo run build --concurrency=1",
    "dev": "turbo run dev --concurrency=20",
    "portless:list": "portless list",
    "portless:proxy": "portless proxy start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "type:check": "turbo run type:check --concurrency=1",
    "test": "turbo run test --concurrency=1",
    "test:run": "turbo run test:run --concurrency=1",
    "dev:local": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@refref/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  }
}
